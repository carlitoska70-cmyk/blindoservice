{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blindoservice",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blindoservice-prod",
      "database_id": "dea67c57-3f5c-4e42-b23a-8439081550de",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "blindoservice-documents-prod"
    }
  ],
  "observability": {
    "enabled": true
  }
}
